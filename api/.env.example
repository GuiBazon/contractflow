PORT=8080
DB_HOST=localhost
DB_PORT=3306
DB_USER=user
DB_PASSWORD=password
DB_NAME=contractflow
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Opcional: origens permitidas no CORS (separadas por virgula).
# Vazio ou ausente = permite qualquer origem (apenas para desenvolvimento).
CORS_ORIGINS=
# Diretorio raiz de uploads (relativo a pasta api/). Por padrao: uploads
UPLOAD_DIR=uploads
# Integracao futura com o servico Python de OCR (ocr-service/).
# Mantenha false para nao alterar o comportamento do OCR Node atual.
PYTHON_OCR_ENABLED=false
PYTHON_OCR_URL=http://127.0.0.1:8000
