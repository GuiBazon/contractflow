PORT=8080
DB_HOST=localhost
DB_PORT=3306
DB_USER=user
DB_PASSWORD=password
DB_NAME=contractflow
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Opcional: origens permitidas no CORS (separadas por virgula).
# Vazio ou ausente = permite qualquer origem (apenas para desenvolvimento).
CORS_ORIGINS=
# Diretorio raiz de uploads (relativo a pasta api/). Por padrao: uploads
UPLOAD_DIR=uploads

# Recuperação de senha: Mailpit local captura e-mails, sem envio externo.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=ContractFlow <nao-responda@contractflow.test>
# Em um provedor real, configure usuário/senha pelo ambiente e mantenha TLS.
SMTP_USER=
SMTP_PASSWORD=
PASSWORD_RESET_URL=http://localhost:5173/redefinir-senha
PASSWORD_RESET_TTL_MINUTES=30

# IPs/CIDRs dos proxies confiáveis, separados por vírgula. Vazio = sem proxy.
TRUSTED_PROXIES=
