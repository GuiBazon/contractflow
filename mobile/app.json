{
  "expo": {
    "name": "ContractFlow",
    "slug": "contractflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "navigationBar": {
        "visible": "leanback"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      [
        "expo-navigation-bar",
        {
          "visible": "leanback",
          "behavior": "overlay-swipe"
        }
      ]
    ]
  }
}
