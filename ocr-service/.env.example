OCR_LANGUAGE=por
OCR_MAX_FILE_SIZE_MB=10
OCR_MAX_PDF_PAGES=30
OCR_TIMEOUT_SECONDS=120
OCR_MIN_TEXT_CHARS=30
OCR_TEMP_DIR=
OCR_TESSERACT_PATH=
OCR_GHOSTSCRIPT_PATH=
OCR_PDF_RASTERIZER=auto
OCR_MAX_CONCURRENCY=2
# Rasterizacao propria de PDF escaneado (pypdfium2) + binarizacao adaptativa.
OCR_PDF_RASTER_DPI=300
OCR_PREPROCESS_RADIUS=25
OCR_PREPROCESS_OFFSET=16
PYTHONUNBUFFERED=1
